# Copy to .env and adjust. Every value is optional - docker-compose.yml has defaults.

# MySQL / MongoDB
MYSQL_ROOT_PASSWORD=root
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=mongo123

# Auth (JWT signing key must be at least 32 characters)
JWT_KEY=HawkEye-Development-Signing-Key-Change-Me-0123456789
INTERNAL_API_KEY=hawkeye-internal-key

# Admin account created on first start
ADMIN_EMAIL=emma298450@gmail.com
ADMIN_PASSWORD=Admin123!

# OpenSky: anonymous access has a small daily quota (/states/all costs 4 credits of 400/day).
# Create an API client at https://opensky-network.org (Account -> API client) for more.
OPENSKY_POLLING_SECONDS=90
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional FCM push: path *inside* the worker container to a Firebase service-account JSON
# Put the file in ./secrets (mounted at /app/secrets). Without it, alerts still arrive via
# SignalR and are saved to history.
# e.g. FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase.json
FIREBASE_CREDENTIALS_PATH=
