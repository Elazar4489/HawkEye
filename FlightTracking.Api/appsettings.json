{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=flight_tracking_db;Uid=root;Pwd=root;"
  },
  "MongoSettings": {
    "ConnectionString": "mongodb://admin:mongo123@localhost:27017",
    "DatabaseName": "flight_tracking_db"
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092"
  },
  "Jwt": {
    "Key": "HawkEye-Development-Signing-Key-Change-Me-0123456789",
    "Issuer": "HawkEye",
    "Audience": "HawkEye.Clients",
    "ExpirationHours": 12
  },
  "Internal": {
    "ApiKey": "hawkeye-internal-key"
  },
  "Seed": {
    "AdminEmail": "admin@hawkeye.com",
    "AdminPassword": "Admin123!"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://localhost:9200",
          "indexFormat": "flight-tracking-logs-{0:yyyy.MM.dd}",
          "autoRegisterTemplate": true
        }
      }
    ]
  }
}
